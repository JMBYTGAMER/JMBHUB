{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "JMBHUB",
        "authorizedRedirectUris": [
          "https://jmb-hub.firebaseapp.com/__/auth/handler",
          "https://jmb-hub.web.app/__/auth/handler"
        ]
      }
    }
  }
}
