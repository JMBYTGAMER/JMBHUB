rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.token.email == 'jobinmathewbiju@gmail.com'; }
    function admin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.get('role', '') == 'admin' ||
        owner()
      );
    }
    match /leaderboards/{game}/scores/{scoreId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /tickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin() || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid);
      allow delete: if admin();
    }
    match /suggestions/{suggestionId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin();
      allow delete: if owner();
    }
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if owner();
    }
    match /logs/{logId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.event is string
        && request.resource.data.page is string
        && request.resource.data.event.size() <= 40;
      allow read: if admin();
      allow update, delete: if owner();
    }
    match /globalChat/{messageId} {
      allow read: if signedIn();
      allow create, update: if false;
      allow delete: if admin();
    }

    /* Minimal account directory used by the admin console.
       Users can maintain only their own basic profile fields.
       Admins can read profiles; role/admin claims remain server-controlled. */
    match /profiles/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid','email','displayName','photoURL','emailVerified','lastSeenAt'
        ]);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid','email','displayName','photoURL','emailVerified','lastSeenAt'
        ]);
      allow delete: if owner();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
