rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.token.email == 'jobinmathewbiju@gmail.com'; }
    function admin() { return signedIn() && (request.auth.token.admin == true || owner()); }

    function validScoreGame(game) {
      return game in ['snake','click','reaction','target','game2048','tictactoe','memory','mole','color','guess'];
    }
    function maxScore(game) {
      return game == 'snake' ? 10000 : game == 'click' ? 1000 : game == 'reaction' ? 1000 : game == 'target' ? 1000 : game == 'game2048' ? 100000 : game == 'tictactoe' ? 100 : game == 'memory' ? 200 : game == 'mole' ? 1000 : game == 'color' ? 1000 : 120;
    }

    match /leaderboards/{game}/scores/{scoreId} {
      allow read: if true;
      allow create: if signedIn()
        && validScoreGame(game)
        && request.resource.data.keys().hasOnly(['uid','player','score','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.player is string
        && request.resource.data.player.size() <= 40
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= maxScore(game);
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || admin());
    }


    function isOwner() { return signedIn() && request.auth.token.email == 'jobinmathewbiju@gmail.com'; }
    function isStaff() { return signedIn() && (request.auth.token.admin == true || isOwner()); }

    match /globalChat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','displayName','text','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if isStaff();
    }

    match /tickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','email','subject','message','status','createdAt','updatedAt','replies'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 120
        && request.resource.data.message is string && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'open';
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow update: if signedIn() && (resource.data.uid == request.auth.uid || admin());
      allow delete: if admin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
