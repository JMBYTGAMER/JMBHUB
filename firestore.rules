rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn() && request.auth.token.email == 'jobinmathewbiju@gmail.com';
    }
    function admin() {
      return signedIn() && (request.auth.token.get('admin', false) == true || request.auth.token.get('role', '') == 'admin' || owner());
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if owner();
    }

    match /tickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin() || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid);
      allow delete: if admin();
    }

    match /suggestions/{suggestionId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin();
      allow delete: if owner();
    }

    match /leaderboards/{game}/scores/{scoreId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.score is number;
      allow update, delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /globalChat/{messageId} {
      allow read: if signedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if admin();
    }

    // JMB Coins: users may only read their own wallet/history.
    // All balance mutations happen in trusted Cloud Functions.
    match /wallets/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /coinTransactions/{txId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /coinPurchases/{purchaseId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /coinGameClaims/{claimId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
